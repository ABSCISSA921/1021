Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 32; 32; 32
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
    - Class: rviz/Map
      Name: Map
      Enabled: true
      Topic: /map
      Alpha: 0.7
    - Class: rviz/RobotModel
      Name: Robot
      Enabled: true
      Robot Description: robot_description
    - Class: rviz/LaserScan
      Name: Laser
      Enabled: true
      Topic: /scan
      Size (m): 0.025
      Style: Points
    - Class: rviz/PoseArray
      Name: AMCL particles
      Enabled: true
      Topic: /particlecloud
    - Class: rviz/Path
      Name: Global plan
      Enabled: true
      Topic: /move_base/NavfnROS/plan
    - Class: rviz/Path
      Name: Local plan
      Enabled: true
      Topic: /move_base/DWAPlannerROS/local_plan
    - Class: rviz/Map
      Name: Local costmap
      Enabled: false
      Topic: /move_base/local_costmap/costmap
      Color Scheme: costmap
      Alpha: 0.5
    - Class: rviz/TF
      Name: TF
      Enabled: false
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Scale: 70
      Target Frame: map
      X: 0
      Y: 0
Window Geometry:
  Width: 1200
  Height: 800
