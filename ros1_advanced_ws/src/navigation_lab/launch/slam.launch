<launch>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="use_ekf" default="true"/>
  <arg name="start_sim" default="true"/>
  <!-- start_sim=false reuses an existing simulation with the same use_ekf setting. -->
  <include if="$(arg start_sim)" file="$(find navigation_lab)/launch/simulation.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="use_ekf" value="$(arg use_ekf)"/>
  </include>
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <rosparam command="load" file="$(find navigation_lab)/config/gmapping.yaml"/>
    <remap from="scan" to="/scan"/>
  </node>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find navigation_lab)/rviz/navigation.rviz"/>
</launch>
