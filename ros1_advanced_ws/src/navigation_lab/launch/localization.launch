<launch>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="use_ekf" default="true"/>
  <include file="$(find navigation_lab)/launch/simulation.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="use_ekf" value="$(arg use_ekf)"/>
  </include>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find navigation_lab)/rviz/localization.rviz"/>
</launch>
