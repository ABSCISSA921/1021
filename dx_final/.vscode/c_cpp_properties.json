{
    "configurations": [
        {
            "name": "ROS",
            "includePath": [
                "${workspaceFolder}/**",
                "/opt/ros/noetic/include/**",
                "${workspaceFolder}/devel/include/**"
            ],
            "defines": [],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c17",
            "cppStandard": "gnu++14",
            "intelliSenseMode": "linux-gcc-x64",
            // 让 VSCode 直接读取 catkin build 生成的精确编译数据
            "compileCommands": "${workspaceFolder}/build/sentry_chassis_controller/compile_commands.json"
        }
    ],
    "version": 4
}