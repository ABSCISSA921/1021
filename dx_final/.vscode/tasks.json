{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "catkin build: debug",
            "type": "shell",
            "command": "catkin",
            "args": [
                "build",
                "--cmake-args",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}