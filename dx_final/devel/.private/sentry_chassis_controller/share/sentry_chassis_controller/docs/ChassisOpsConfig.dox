\subsubsection parameters ROS parameters

Reads and maintains the following parameters on the ROS server

- \b "~lf_steer_p" : \b [double] LF Steer P min: 0.0, default: 10.0, max: 1000.0
- \b "~lf_steer_i" : \b [double] LF Steer I min: 0.0, default: 0.1, max: 50.0
- \b "~lf_steer_d" : \b [double] LF Steer D min: 0.0, default: 5.0, max: 50.0
- \b "~rf_steer_p" : \b [double] RF Steer P min: 0.0, default: 10.0, max: 1000.0
- \b "~rf_steer_i" : \b [double] RF Steer I min: 0.0, default: 0.1, max: 50.0
- \b "~rf_steer_d" : \b [double] RF Steer D min: 0.0, default: 5.0, max: 50.0
- \b "~lb_steer_p" : \b [double] LB Steer P min: 0.0, default: 10.0, max: 1000.0
- \b "~lb_steer_i" : \b [double] LB Steer I min: 0.0, default: 0.1, max: 50.0
- \b "~lb_steer_d" : \b [double] LB Steer D min: 0.0, default: 5.0, max: 50.0
- \b "~rb_steer_p" : \b [double] RB Steer P min: 0.0, default: 10.0, max: 1000.0
- \b "~rb_steer_i" : \b [double] RB Steer I min: 0.0, default: 0.1, max: 50.0
- \b "~rb_steer_d" : \b [double] RB Steer D min: 0.0, default: 5.0, max: 50.0
- \b "~lf_wheel_p" : \b [double] LF Wheel P min: 0.0, default: 5.0, max: 20.0
- \b "~lf_wheel_i" : \b [double] LF Wheel I min: 0.0, default: 0.1, max: 100.0
- \b "~lf_wheel_d" : \b [double] LF Wheel D min: 0.0, default: 0.0, max: 50.0
- \b "~lf_wheel_max" : \b [double] LF Max Torque min: 0.0, default: 3.0, max: 100.0
- \b "~rf_wheel_p" : \b [double] RF Wheel P min: 0.0, default: 5.0, max: 100.0
- \b "~rf_wheel_i" : \b [double] RF Wheel I min: 0.0, default: 0.1, max: 100.0
- \b "~rf_wheel_d" : \b [double] RF Wheel D min: 0.0, default: 0.0, max: 50.0
- \b "~rf_wheel_max" : \b [double] RF Max Torque min: 0.0, default: 3.0, max: 100.0
- \b "~lb_wheel_p" : \b [double] LB Wheel P min: 0.0, default: 5.0, max: 100.0
- \b "~lb_wheel_i" : \b [double] LB Wheel I min: 0.0, default: 0.1, max: 100.0
- \b "~lb_wheel_d" : \b [double] LB Wheel D min: 0.0, default: 0.0, max: 50.0
- \b "~lb_wheel_max" : \b [double] LB Max Torque min: 0.0, default: 3.0, max: 100.0
- \b "~rb_wheel_p" : \b [double] RB Wheel P min: 0.0, default: 5.0, max: 100.0
- \b "~rb_wheel_i" : \b [double] RB Wheel I min: 0.0, default: 0.1, max: 100.0
- \b "~rb_wheel_d" : \b [double] RB Wheel D min: 0.0, default: 0.0, max: 50.0
- \b "~rb_wheel_max" : \b [double] RB Max Torque min: 0.0, default: 3.0, max: 100.0
- \b "~wheel_track" : \b [double] Wheel Track min: 0.1, default: 0.362, max: 1.0
- \b "~wheel_base" : \b [double] Wheel Base min: 0.1, default: 0.362, max: 1.0
- \b "~offset_lf" : \b [double] Offset LF min: -3.14, default: 0.0, max: 3.14
- \b "~offset_rf" : \b [double] Offset RF min: -3.14, default: 0.0, max: 3.14
- \b "~offset_lb" : \b [double] Offset LB min: -3.14, default: 0.0, max: 3.14
- \b "~offset_rb" : \b [double] Offset RB min: -3.14, default: 0.0, max: 3.14
- \b "~spin_vw" : \b [double] Spin Speed min: 0.0, default: 5.0, max: 20.0
- \b "~use_world_frame" : \b [bool] World Frame min: False, default: False, max: True
- \b "~acc_linear" : \b [double] Linear Acc (m/s^2) min: 0.1, default: 20.0, max: 20.0
- \b "~acc_angular" : \b [double] Angular Acc (rad/s^2) min: 0.1, default: 20.0, max: 20.0

