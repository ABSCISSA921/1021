\subsubsection usage Usage
\verbatim
<node name="sentry_chassis_controller" pkg="sentry_chassis_controller" type="sentry_chassis_controller">
  <param name="lf_steer_p" type="double" value="10.0" />
  <param name="lf_steer_i" type="double" value="0.1" />
  <param name="lf_steer_d" type="double" value="5.0" />
  <param name="rf_steer_p" type="double" value="10.0" />
  <param name="rf_steer_i" type="double" value="0.1" />
  <param name="rf_steer_d" type="double" value="5.0" />
  <param name="lb_steer_p" type="double" value="10.0" />
  <param name="lb_steer_i" type="double" value="0.1" />
  <param name="lb_steer_d" type="double" value="5.0" />
  <param name="rb_steer_p" type="double" value="10.0" />
  <param name="rb_steer_i" type="double" value="0.1" />
  <param name="rb_steer_d" type="double" value="5.0" />
  <param name="lf_wheel_p" type="double" value="5.0" />
  <param name="lf_wheel_i" type="double" value="0.1" />
  <param name="lf_wheel_d" type="double" value="0.0" />
  <param name="lf_wheel_max" type="double" value="3.0" />
  <param name="rf_wheel_p" type="double" value="5.0" />
  <param name="rf_wheel_i" type="double" value="0.1" />
  <param name="rf_wheel_d" type="double" value="0.0" />
  <param name="rf_wheel_max" type="double" value="3.0" />
  <param name="lb_wheel_p" type="double" value="5.0" />
  <param name="lb_wheel_i" type="double" value="0.1" />
  <param name="lb_wheel_d" type="double" value="0.0" />
  <param name="lb_wheel_max" type="double" value="3.0" />
  <param name="rb_wheel_p" type="double" value="5.0" />
  <param name="rb_wheel_i" type="double" value="0.1" />
  <param name="rb_wheel_d" type="double" value="0.0" />
  <param name="rb_wheel_max" type="double" value="3.0" />
  <param name="wheel_track" type="double" value="0.362" />
  <param name="wheel_base" type="double" value="0.362" />
  <param name="offset_lf" type="double" value="0.0" />
  <param name="offset_rf" type="double" value="0.0" />
  <param name="offset_lb" type="double" value="0.0" />
  <param name="offset_rb" type="double" value="0.0" />
  <param name="spin_vw" type="double" value="5.0" />
  <param name="use_world_frame" type="bool" value="False" />
  <param name="acc_linear" type="double" value="20.0" />
  <param name="acc_angular" type="double" value="20.0" />
</node>
\endverbatim

